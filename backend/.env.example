# Copy to backend/.env and adjust. Never commit the real .env.
# PostgreSQL connection (psycopg 3 driver). Example with password auth:
#   postgresql+psycopg://itsm_user:change-me@localhost:5432/itsm
ITSM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/itsm

# HS256 signing key, >= 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ITSM_JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
ITSM_JWT_EXPIRY_MINUTES=60

# Only the Vite dev server may call the API from a browser
ITSM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Background SLA monitor period (seconds)
ITSM_SLA_CHECK_INTERVAL_SECONDS=60

# Simulate provider outages (network failure) for the demo
ITSM_SIMULATE_EMAIL_FAILURE=false
ITSM_SIMULATE_SMS_FAILURE=false

ITSM_LOG_LEVEL=INFO
